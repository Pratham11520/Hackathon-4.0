# Never commit the completed .env file.

NEBULA_DB_HOST=localhost
NEBULA_DB_USER=your_database_user
NEBULA_DB_PASSWORD=replace_with_a_strong_password
NEBULA_DB_NAME=your_database_name
NEBULA_DEFAULT_PASSWORD=replace_with_a_strong_default_password
